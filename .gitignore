# Local editor, agent, and interpreter state
.codex/
.idea/
.DS_Store
__pycache__/
*.py[cod]
.coverage

# Visibility 2x2 board: written by its save endpoint, not source
docs/visibility-2x2/items.bak.json
docs/visibility-2x2/items.json.tmp

# Visibility 2x2 template exports: session artifacts, not source
/visibility-2x2-template/
/visibility-2x2-template-alt/
/visibility-2x2-template.zip
/VISIBILITY_2X2_TEMPLATE_SUMMARY.md

# Spacedock worktrees: per-entity checkouts, never source
.worktrees/

# Agent worktrees: CLAUDE.md sends `isolation: "worktree"` checkouts here. Ignored
# in the committed file and not only in .git/info/exclude, because that exclude is
# per-clone: without this, a fresh clone greps its own worktrees and every
# repo-wide search returns each hit once per checkout.
.claude/worktrees/

# Spacedock roadmap-burndown state: a linked worktree of the spacedock-state/roadmap-burndown orphan branch
docs/roadmap-burndown/.spacedock-state/
docs/future-ui-exploration/.spacedock-state/

# Spacedock mods: vendored from the plugin at install time, not source.
# Restoring: see docs/roadmap-burndown/README.md, "Workflow State".
docs/roadmap-burndown/_mods/

# Browser screenshots: agent capture artifacts, not source. The directory itself is
# tracked through its .gitkeep, so a fresh clone has somewhere to put a capture; ignoring
# `docs/screenshots/` outright would leave nothing for the negation below to rescue.
docs/screenshots/*
!docs/screenshots/.gitkeep

# Feedback studies: local session write-ups that name real session IDs and quote real
# prompts, so they stay on the machine that made them. The .gitkeep keeps the directory.
docs/feedback/*
!docs/feedback/.gitkeep

# Session fixtures: the full sanitized JSONL of each session stays on the machine that made
# it, because teammates are not comfortable with transcripts in a public repository even
# sanitized. Only the steering excerpts (.txt) and the annotations (.md) are committed.
# Everything under a session's raw directory except its committed excerpts: the logs, their
# subagents (which also hold .json metadata with absolute paths), and any tool-results directory.
tests/raw_sessions/*/*
!tests/raw_sessions/*/steering-excerpts.txt
tests/raw_sessions/**/*.jsonl
tests/annotated_sessions/**/*.jsonl
# The drift replay check's local files, should COMPASS_HOME ever point at the repository root.
/drift-replay/

# Frontend dependency, build and browser-test artifacts (source stays tracked).
node_modules/
/.frontend-build/
/coverage/
/test-results/
/playwright-report/
/.pnpm-store/
*.tsbuildinfo
/.storybook-build/

# The sample session's mapping holds the original names and paths it replaced: never commit one.
sample-session/*mapping*.json
sample-session/*.table.json

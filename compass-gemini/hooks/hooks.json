{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "name": "compass-session-started",
            "command": "python3 \"${extensionPath}/hooks/launch.py\" \"${extensionPath}/hooks/event_hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "name": "compass-turn-started",
            "command": "python3 \"${extensionPath}/hooks/launch.py\" \"${extensionPath}/hooks/event_hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "name": "compass-store-changed",
            "command": "python3 \"${extensionPath}/hooks/launch.py\" \"${extensionPath}/hooks/event_hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "name": "compass-turn-stopped",
            "command": "python3 \"${extensionPath}/hooks/launch.py\" \"${extensionPath}/hooks/event_hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "name": "compass-session-ended",
            "command": "python3 \"${extensionPath}/hooks/launch.py\" \"${extensionPath}/hooks/event_hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
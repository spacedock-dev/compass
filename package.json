{
  "name": "compass-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "node frontend/dev/supervisor.mjs",
    "dev:preview": "vite --config frontend/vite.config.mts",
    "build": "node frontend/build/package.mjs",
    "preview": "vite preview --config frontend/vite.config.mts",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit && tsc --noEmit --project frontend/.storybook/tsconfig.json",
    "test": "vitest run && node --test frontend/build/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "build:preview": "vite build --config frontend/vite.config.mts",
    "build:check": "node frontend/build/package.mjs --check",
    "test:build": "node --test frontend/build/package.test.mjs",
    "test:parser": "node --test frontend/e2e/parser.test.mjs",
    "test:installed": "node frontend/e2e/installed.mjs",
    "test:storage:browser": "node frontend/e2e/storage-conformance.mjs",
    "test:dev": "node --test --test-concurrency=1 frontend/dev/*.test.mjs",
    "test:dev:browser": "node frontend/e2e/development.mjs",
    "test:shell:browser": "node frontend/e2e/shell-routing.mjs",
    "test:popover:browser": "node --test frontend/e2e/support/proof-copy.test.mjs && node frontend/e2e/popover-continuity.mjs",
    "test:controls:browser": "node --test frontend/e2e/support/proof-copy.test.mjs && node frontend/e2e/controls-continuity.mjs && node frontend/e2e/popover-continuity.mjs",
    "test:sessions:browser": "node --test frontend/e2e/support/session-deviations.test.mjs && node frontend/e2e/sessions-parity.mjs",
    "test:intent:browser": "node frontend/e2e/intent-parity.mjs && node frontend/e2e/session-first-view.mjs",
    "test:drift:browser": "node frontend/e2e/drift-parity.mjs",
    "test:journey:browser": "node frontend/e2e/journey-budget.mjs",
    "test:console:browser": "node frontend/e2e/console-parity.mjs",
    "test:project:browser": "node frontend/e2e/project-parity.mjs",
    "test:attention:browser": "node frontend/e2e/attention-parity.mjs",
    "test:capacity:browser": "node frontend/e2e/capacity-parity.mjs",
    "test:terminal:browser": "node frontend/e2e/terminal-parity.mjs && node frontend/e2e/timeline-filter.mjs",
    "test:css:browser": "node --test frontend/e2e/support/session-chrome.test.mjs frontend/e2e/support/project-chrome.test.mjs frontend/e2e/support/attention-chrome.test.mjs && node frontend/e2e/css-contract.mjs",
    "test:production:browser": "node frontend/e2e/production-proofs.mjs",
    "test:css:coverage": "node frontend/build/css-coverage.mjs check",
    "test:styles": "node frontend/build/style-policy.mjs",
    "storybook": "node frontend/storybook/run.mjs dev",
    "build:storybook": "node frontend/storybook/run.mjs build",
    "test:stories": "node frontend/storybook/run.mjs test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
